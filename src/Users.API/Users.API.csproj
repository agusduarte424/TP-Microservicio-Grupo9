<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- genera Users.API.xml con los XML comments, que Swagger muestra en la documentación -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- CS1591 = "falta el comentario XML": no queremos advertencias por cada miembro sin comentar -->
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.79" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Expressions" Version="5.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Controllers\" />
		<Folder Include="Data\" />
		<Folder Include="DTOs\" />
		<Folder Include="Exceptions\" />
		<Folder Include="ExceptionHandlers\" />
		<Folder Include="Models\" />
		<Folder Include="Services\" />
	</ItemGroup>

</Project>