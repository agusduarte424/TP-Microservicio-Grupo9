@baseUrl = http://localhost:5003
@productsUrl = http://localhost:5001
@userId = 11111111-1111-1111-1111-111111111111
# Pegá acá el id de un producto real (sale del GET de productos)
@productId = 2a2ca768-9fe5-4b35-9d90-cd7bec2375e6

### Listar productos (para sacar un id real)
GET {{productsUrl}}/api/products

### 1. Agregar producto al carrito (201/200)
POST {{baseUrl}}/api/cart/{{userId}}/items
Content-Type: application/json
X-Correlation-Id: prueba-cart-1

{
  "productoId": "{{productId}}",
  "cantidad": 1
}

### 2. Ver carrito (200)
GET {{baseUrl}}/api/cart/{{userId}}

### 3. Cambiar cantidad (200)
PUT {{baseUrl}}/api/cart/{{userId}}/items/{{productId}}
Content-Type: application/json

{
  "cantidad": 2
}

### 4. Quitar producto (204)
DELETE {{baseUrl}}/api/cart/{{userId}}/items/{{productId}}

### 5. Vaciar carrito (204)
DELETE {{baseUrl}}/api/cart/{{userId}}

### ERROR CRT-001: carrito inexistente (404)
GET {{baseUrl}}/api/cart/99999999-9999-9999-9999-999999999999

### ERROR CRT-002: producto inexistente (404)
POST {{baseUrl}}/api/cart/{{userId}}/items
Content-Type: application/json

{
  "productoId": "00000000-0000-0000-0000-000000000001",
  "cantidad": 1
}

### ERROR CRT-003: stock insuficiente (422)
POST {{baseUrl}}/api/cart/{{userId}}/items
Content-Type: application/json

{
  "productoId": "{{productId}}",
  "cantidad": 9999
}

### ERROR CRT-004: cantidad inválida (400)
POST {{baseUrl}}/api/cart/{{userId}}/items
Content-Type: application/json

{
  "productoId": "{{productId}}",
  "cantidad": 0
}